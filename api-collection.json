{
	"info": {
		"_postman_id": "erp-inventory-pos-collection",
		"name": "ERP Inventory & POS",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@erp.com\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/api/users/login",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"users",
								"login"
							]
						}
					}
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "Get Products",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{TOKEN}}"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/api/products?page=1&limit=10",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"products"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Sales",
			"item": [
				{
					"name": "Create Sale",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{TOKEN}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customerName\": \"John Doe\",\n    \"customerPhone\": \"01711223344\",\n    \"products\": [\n        {\n            \"product\": \"60f1b9b9b9b9b9b9b9b9b9b9\",\n            \"quantity\": 2,\n            \"price\": 1500\n        }\n    ],\n    \"totalAmount\": 3000,\n    \"discount\": 0,\n    \"grandTotal\": 3000,\n    \"paymentMethod\": \"Cash\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/api/sales",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"sales"
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "BASE_URL",
			"value": "http://localhost:5000"
		},
		{
			"key": "TOKEN",
			"value": "your_jwt_token_here"
		}
	]
}
